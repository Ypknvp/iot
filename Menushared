Here is the **complete runnable Android project code** using Kotlin that demonstrates:

* Menu option
* SharedPreferences (saving data)
* Implicit Intent (open a website)

You can copy this directly into Android Studio.

---

### 1. `MainActivity.kt`

```kotlin
package com.example.sharedprefintent

import android.content.Intent
import android.content.SharedPreferences
import android.net.Uri
import android.os.Bundle
import android.view.Menu
import android.view.MenuItem
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity

class MainActivity : AppCompatActivity() {
    lateinit var prefs: SharedPreferences

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        // Save data to SharedPreferences
        prefs = getSharedPreferences("myPrefs", MODE_PRIVATE)
        prefs.edit().putString("user", "Nithish").apply()

        // Optional: Show saved value
        val savedUser = prefs.getString("user", "No Name")
        Toast.makeText(this, "User: $savedUser", Toast.LENGTH_SHORT).show()
    }

    override fun onCreateOptionsMenu(menu: Menu): Boolean {
        menuInflater.inflate(R.menu.main_menu, menu)
        return true
    }

    override fun onOptionsItemSelected(item: MenuItem): Boolean {
        return when (item.itemId) {
            R.id.menu_open_website -> {
                // Open website using implicit intent
                val intent = Intent(Intent.ACTION_VIEW, Uri.parse("https://example.com"))
                startActivity(intent)
                true
            }
            else -> super.onOptionsItemSelected(item)
        }
    }
}
```

