### ✅ `MainActivity.kt` (Simplified Logic)

```kotlin
package com.example.intentdemo

import android.bluetooth.BluetoothAdapter
import android.content.ContentValues
import android.content.Context
import android.content.Intent
import android.database.sqlite.SQLiteDatabase
import android.database.sqlite.SQLiteOpenHelper
import android.media.MediaPlayer
import android.net.Uri
import android.net.wifi.WifiManager
import android.os.Bundle
import android.widget.Button
import androidx.appcompat.app.AppCompatActivity
import com.google.firebase.FirebaseApp
import com.google.firebase.firestore.FirebaseFirestore

class MainActivity : AppCompatActivity() {

    lateinit var db: SQLiteDatabase
    lateinit var firestore: FirebaseFirestore

    override fun onCreate(b: Bundle?) {
        super.onCreate(b)
        setContentView(R.layout.activity_main)

        FirebaseApp.initializeApp(this)
        firestore = FirebaseFirestore.getInstance()
        db = MyDB(this).writableDatabase

        findViewById<Button>(R.id.sms).setOnClickListener {
            startActivity(Intent(Intent.ACTION_VIEW, Uri.parse("smsto:12345")).putExtra("sms_body", "Hello"))
        }

        findViewById<Button>(R.id.web).setOnClickListener {
            startActivity(Intent(Intent.ACTION_VIEW, Uri.parse("https://google.com")))
        }

        findViewById<Button>(R.id.audio).setOnClickListener {
            MediaPlayer.create(this, R.raw.sample_audio).start()
        }

        findViewById<Button>(R.id.video).setOnClickListener {
            val uri = Uri.parse("android.resource://$packageName/${R.raw.sample_video}")
            startActivity(Intent(Intent.ACTION_VIEW).setDataAndType(uri, "video/*"))
        }

        findViewById<Button>(R.id.bluetooth).setOnClickListener {
            val b = BluetoothAdapter.getDefaultAdapter()
            val intent = if (b?.isEnabled == true) Intent(BluetoothAdapter.ACTION_REQUEST_DISABLE)
                         else Intent(BluetoothAdapter.ACTION_REQUEST_ENABLE)
            startActivity(intent)
        }

        findViewById<Button>(R.id.wifi).setOnClickListener {
            val wifi = applicationContext.getSystemService(Context.WIFI_SERVICE) as WifiManager
            wifi.isWifiEnabled = !wifi.isWifiEnabled
        }

        findViewById<Button>(R.id.sqlite).setOnClickListener {
            val values = ContentValues().apply {
                put("name", "User")
                put("info", "Saved to SQLite")
            }
            db.insert("demo", null, values)
        }

        findViewById<Button>(R.id.firebase).setOnClickListener {
            val data = hashMapOf("name" to "User", "info" to "Saved to Firestore")
            firestore.collection("demo").add(data)
        }
    }

    class MyDB(context: Context) : SQLiteOpenHelper(context, "mydb", null, 1) {
        override fun onCreate(db: SQLiteDatabase) {
            db.execSQL("CREATE TABLE IF NOT EXISTS demo (id INTEGER PRIMARY KEY, name TEXT, info TEXT)")
        }
        override fun onUpgrade(db: SQLiteDatabase, old: Int, newv: Int) {}
    }
}
```

